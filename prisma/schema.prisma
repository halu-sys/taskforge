generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTH
  YEAR
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  sessions     Session[]
  memberships  Membership[]
  comments     Comment[]
  activity     ActivityEvent[] @relation("Actor")
  assignedTasks Task[]      @relation("Assignee")
  createdTasks Task[]       @relation("Creator")
  notifications Notification[]
  invitationsSent Invitation[] @relation("Inviter")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  invitations   Invitation[]
  projects      Project[]
  activity      ActivityEvent[]
  subscription  Subscription?
  invoices      Invoice[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   Role   @default(MEMBER)
  joinedAt DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invitation {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  token      String    @unique
  role       Role      @default(MEMBER)
  invitedById String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy  User     @relation("Inviter", fields: [invitedById], references: [id])

  @@unique([orgId, email])
}

model Project {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  key       String   // short code e.g. "ACME-1"
  nextNumber Int     @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boards    Board[]
  activity  ActivityEvent[]

  @@unique([orgId, key])
  @@index([orgId])
}

model Board {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id          String       @id @default(cuid())
  boardId     String
  orgId       String
  number      Int          // per-project task number
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NONE)
  position    Float        @default(0)
  dueDate     DateTime?
  labels      String[]
  assigneeId  String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("Creator", fields: [createdById], references: [id])
  comments    Comment[]

  @@index([orgId, status])
  @@index([boardId, position])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model ActivityEvent {
  id       String   @id @default(cuid())
  orgId    String
  actorId  String?
  projectId String?
  verb     String   // e.g. "task.created", "member.invited"
  targetType String  // task | comment | member | project | org | subscription
  targetId String?
  payload  Json?
  createdAt DateTime @default(now())
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor    User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  verb      String
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Plan {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  priceCents      Int
  interval        BillingInterval @default(MONTH)
  maxMembers      Int
  maxProjects     Int
  maxTasksPerOrg  Int
  features        Json
  subscriptions   Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  orgId              String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  seats              Int                @default(1)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  pendingPlanId      String?            // downgrade scheduled at period end
  paymentToken       String?            // stored (fake) payment method reference
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  providerId         String?            // id at the (fake) payment provider
  dunningFailures    Int                @default(0)
  createdAt          DateTime           @default(now())
  org                Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])
  invoices           Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  orgId          String
  subscriptionId String
  number         String        @unique
  status         InvoiceStatus @default(OPEN)
  amountCents    Int
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lines          InvoiceLine[]
  payments       Payment[]
}

model InvoiceLine {
  id         String  @id @default(cuid())
  invoiceId  String
  description String
  amountCents Int
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  providerId String?
  amountCents Int
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Counter {
  key   String @id
  value Int
}
